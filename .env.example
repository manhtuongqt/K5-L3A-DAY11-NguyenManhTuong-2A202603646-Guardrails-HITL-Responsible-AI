# Copy to .env only if it does not exist. Never commit real API keys.
# BLUE: required LFM3-1.7B, direct Liquid API.
BLUE_PROVIDER=liquid
LIQUID_API_KEY=liquid_...
# Fixed endpoint: https://api.liquid.ai/openai/v1 ; fixed model: lfm3-1.7b

# RED + RED ADVANCE: CKey / Opus 5, as allowed by coach for this session.
RED_TEAM_PROVIDER=ckey
OPENAI_BASE_URL=https://api.xah.io/v1
OPENAI_API_KEY=your-ckey-key-here
OPENAI_MODEL=claude-opus-5
# These same settings also configure NeMo self-check input/output rails.
# NEMO_GUARDRAILS_NO_USAGE_STATS=1

# Alternative original starter configuration: Blue through OpenRouter.
# BLUE_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Alternative Red: direct OpenAI (remove CKey OPENAI_BASE_URL above).
# RED_TEAM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Alternative Red: Gemini.
# RED_TEAM_PROVIDER=gemini
# GOOGLE_API_KEY=your-google-ai-studio-key-here
# GOOGLE_GENAI_USE_VERTEXAI=0
# GEMINI_MODEL=gemini-3.5-flash
